# Local SQLite database. On Render, point this at the mounted disk, e.g.
# DATABASE_URL="file:/var/data/finance.db"
DATABASE_URL="file:./dev.db"

# Port the API listens on (Render provides PORT automatically).
PORT=4000

# Comma-separated list of allowed frontend origins for CORS.
# Example: https://your-app.vercel.app
CORS_ORIGIN="*"

# Secret used to sign auth tokens. Use a long random string in production.
JWT_SECRET="change-me-to-a-long-random-string"

# ---- Month-end summary emails (all optional) ---------------------------------
# Leave these unset and the app still works: summaries appear as in-app
# notifications, and email delivery is skipped.
#
# For Gmail, create an App Password (NOT your Google password) at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="you@gmail.com"
# SMTP_PASS="your-16-char-app-password"
# SMTP_FROM="Finance Tracker <you@gmail.com>"

# Shared secret protecting POST /api/cron/monthly-summary. An external scheduler
# (e.g. cron-job.org) sends it as the `x-cron-secret` header once a month.
# CRON_SECRET="a-long-random-string"
