// Prisma schema for the Personal Finance Tracker.
// Multi-user: every record belongs to a User.
//
// Postgres (rather than SQLite) because the app is deployed on a host with an
// ephemeral filesystem — a SQLite file would be wiped on every restart and
// redeploy, taking every account and balance with it. A managed Postgres
// (e.g. Neon) persists independently of the web service.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// An application user. Data is fully isolated per user.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())

  expenses   Expense[]
  incomes    Income[]
  budgets    Budget[]
  debts      Debt[]
  recurrings Recurring[]
  categories Category[]
  budgetAlerts BudgetAlert[]

  // Group / shared-expense relations
  createdGroups       Group[]             @relation("GroupCreator")
  memberships         GroupMember[]
  groupExpensesPaid   GroupExpense[]      @relation("ExpensePayer")
  groupExpenseShares  GroupExpenseSplit[]
  settlementsSent     Settlement[]        @relation("SettlementFrom")
  settlementsReceived Settlement[]        @relation("SettlementTo")
  notifications       Notification[]
}

/// A group of people who share expenses (a trip, a flat, a dinner crew).
/// Anyone holding `inviteCode` can join.
model Group {
  id          String   @id @default(cuid())
  name        String
  inviteCode  String   @unique
  createdById String
  createdBy   User     @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  members     GroupMember[]
  expenses    GroupExpense[]
  settlements Settlement[]
}

/// Membership join table. A user may belong to many groups.
model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

/// A shared expense: one member paid, and some set of members owe a share of it.
model GroupExpense {
  id          String   @id @default(cuid())
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidById    String
  paidBy      User     @relation("ExpensePayer", fields: [paidById], references: [id], onDelete: Cascade)
  description String
  amount      Float
  date        DateTime
  // splitMode: "equal" | "custom" | "percent" — how `splits` was derived.
  splitMode   String   @default("equal")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  splits GroupExpenseSplit[]

  @@index([groupId, date])
}

/// One member's share of a GroupExpense. Shares always sum to the expense total.
model GroupExpenseSplit {
  id        String       @id @default(cuid())
  expenseId String
  expense   GroupExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Float

  @@unique([expenseId, userId])
  @@index([userId])
}

/// A repayment from one member to another. The debtor records it ("I paid you"),
/// the creditor confirms it ("received"). Only `confirmed` settlements move balances.
model Settlement {
  id          String    @id @default(cuid())
  groupId     String
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromUserId  String
  fromUser    User      @relation("SettlementFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId    String
  toUser      User      @relation("SettlementTo", fields: [toUserId], references: [id], onDelete: Cascade)
  amount      Float
  note        String?
  // status: "pending" (claimed, awaiting confirmation) | "confirmed" | "declined"
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  @@index([groupId, status])
  @@index([toUserId, status])
}

/// In-app notification. Also the source record for month-end summary emails.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // type: "expense_added" | "settlement_requested" | "settlement_confirmed"
  //     | "settlement_declined" | "monthly_summary" | "member_joined"
  //     | "budget_warning" | "budget_exceeded"
  type      String
  title     String
  body      String
  groupId   String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

/// Records each budget alert already sent (e.g. "budget:2026-09:Food:over") so
/// the same alert is never delivered twice.
model BudgetAlert {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  createdAt DateTime @default(now())

  @@unique([userId, key])
}

/// An expense category the user tracks. `monthlyGoal` is the standing spending
/// limit applied to every month; a Budget row for a specific month overrides it
/// for that month only. Archived categories are hidden from pickers but keep
/// their history.
model Category {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  monthlyGoal Float?
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([userId, name])
}

/// A single spending record.
model Expense {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime
  category      String
  description   String
  amount        Float
  paymentMethod String   @default("Cash") // Cash | Bank | eSewa | Khalti
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, date])
  @@index([userId, category])
}

/// A single income record.
model Income {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  source    String
  amount    Float
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
}

/// A one-month budget for a category, overriding the category's standing
/// `monthlyGoal` for that month. `month` is stored as `YYYY-MM`.
model Budget {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month     String // e.g. "2026-07"
  category  String
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month, category])
  @@index([userId, month])
}

/// A recurring transaction rule. Generates Expense or Income records on a
/// schedule when materialized (see routes/recurring.ts). `nextRun` tracks the
/// date of the next occurrence still to be created.
model Recurring {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // type: "expense" | "income"
  type          String   @default("expense")
  // frequency: "weekly" | "monthly"
  frequency     String   @default("monthly")
  // For expenses: category + paymentMethod. For income: category holds the source.
  category      String
  description   String
  amount        Float
  paymentMethod String   @default("Cash")
  notes         String?
  startDate     DateTime
  // Optional end date — no occurrences are generated after it.
  endDate       DateTime?
  // Date of the next occurrence to generate. Advances as records are created.
  nextRun       DateTime
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, active])
}

/// Money owed — either the user owes someone, or someone owes the user.
model Debt {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  person      String
  amount      Float
  description String?
  dueDate     DateTime?
  // direction: "i_owe" (I owe them) | "owed_to_me" (they owe me)
  direction   String    @default("i_owe")
  // status: "pending" | "paid"
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, direction])
  @@index([userId, status])
}
